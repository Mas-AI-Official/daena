# ==============================================================
# Daena V2 Production Environment Variables
# ==============================================================
# Copy to .env.production and fill in real values.
# NEVER commit .env.production to version control.
# ==============================================================

# --- Application ---
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
ENVIRONMENT=production
DAENA_VERSION=2.0.0

# --- Database (overridden by docker-compose, kept for Cloud Run) ---
DATABASE_URL=postgresql+asyncpg://daena:password@postgres:5432/daena
POSTGRES_PASSWORD=change-me-to-random-32-chars

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Security (MUST change before deployment) ---
JWT_SECRET_KEY=change-me-to-random-64-chars
VAULT_ENCRYPTION_KEY=change-me-to-random-64-chars

# --- CORS (JSON array or comma-separated) ---
CORS_ORIGINS=["https://daena.mas-ai.co"]

# --- Auth ---
DISABLE_AUTH=false
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OAuth (optional, fill if using social login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=https://daena.mas-ai.co

# --- LLM Providers ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
PERPLEXITY_API_KEY=

# --- V2: Swarm Executor ---
SWARM_MAX_PARALLEL_SUBTASKS=5
SWARM_SUBTASK_TIMEOUT_SECONDS=300

# --- V2: Autopilot (AGI Mode) ---
AUTOPILOT_COST_CEILING_USD=10.00
AUTOPILOT_APPROVAL_TIMEOUT_SECONDS=300
AUTOPILOT_MAX_STEPS_PER_SESSION=50

# --- V2: MCP Server ---
MCP_SERVER_ENABLED=true

# --- V2: Voice ---
# Browser-native STT/TTS has no backend config.
# Future: set WHISPER_API_KEY or ELEVENLABS_API_KEY here.

# --- Feature Flags ---
ENABLE_WEB3=false
ENABLE_DAENABOT=false

# --- Celery (if using worker) ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Daena-Mind Vault Mount ---
DAENA_MIND_PATH=/path/to/daena-mind
