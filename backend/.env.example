# ============================================================
# Daena Backend — Environment Configuration
# ============================================================
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================
# Local canonical startup now prefers backend/.env over inherited shell env.
# To deliberately invert that for a deployment-style runtime, set:
#   DAENA_ENV_PRECEDENCE=process_env_first

# --- Application ---
APP_NAME=Daena
# Allowed local/dev-style values for unsafe shortcuts: development, dev, local, test
APP_ENV=development
# Must be false in production
DEBUG=true
LOG_LEVEL=INFO

# --- Database (PostgreSQL 16 + asyncpg) ---
DATABASE_URL=postgresql+asyncpg://daena:daena_dev_password@localhost:5432/daena
DATABASE_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Authentication (JWT) ---
# IMPORTANT: Generate a secure random key for production:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE-ME-in-production-use-64-char-random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24h for dev; set to 15 in production
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# JSON array or comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- LLM Providers ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1:latest
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
GROQ_API_KEY=

# --- Feature Flags ---
ENABLE_WEB3=false
ENABLE_DAENABOT=false
# Only allowed in local/test-style environments. Runtime now rejects it elsewhere.
DISABLE_AUTH=false

# --- Governance Mode ---
# UNLEASHED = No governance pipeline. Shield only. Raw power.
# BALANCED  = Light governance (auto-proceed most actions)
# GOVERNED  = Full 10-stage pipeline (enterprise, default)
GOVERNANCE_MODE=GOVERNED

# --- Vault Encryption ---
# IMPORTANT: Generate a 32-byte key for production:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VAULT_ENCRYPTION_KEY=CHANGE-ME-32-byte-key-for-aes256

# --- Celery (background tasks) ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Daena Identity (AI VP email + autonomous operations) ---
# Daena's own professional email for autonomous outreach, signups, etc.
DAENA_EMAIL=daena@mas-ai.co
DAENA_EMAIL_APP_PASSWORD=
DAENA_SMTP_HOST=smtp.gmail.com
DAENA_SMTP_PORT=587

# Founder accounts (Daena reads these for context, never impersonates)
FOUNDER_EMAIL=masoud.masoori@mas-ai.co
FOUNDER_PERSONAL_EMAIL=masoud.masoori@gmail.com

# Controls whether Daena can send emails autonomously
# "governed" = Tier 2+ governance (default, recommended)
# "ask_always" = Tier 3 approval for every email
# "disabled" = no autonomous email
DAENA_EMAIL_MODE=governed

# --- Local LLM Runtime (llama.cpp llama-server / vLLM, OpenAI-compat) ---
# Daena's local inference endpoint. Default = llama.cpp llama-server.
VLLM_BASE_URL=http://127.0.0.1:8080/v1
# llama-server lifecycle ownership: off | respect_external | force
# "off" = user launches it manually (safest, default)
LLAMA_SERVER_MANAGED=off
# Ollama is deprecated; kept for backward compat only
OLLAMA_ENABLED=false

# --- Push Alerts (Web Push founder-alert mirror) ---
# Keys live ONLY in env, never in source. Generate a VAPID keypair:
#   vapid --gen   (or openssl ecparam -name prime256v1)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI for the push service, e.g. mailto:ops@mas-ai.co
VAPID_SUBJECT=
