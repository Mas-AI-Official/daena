%% ============================================================
%% EDGES — primary data and action flow
%% ============================================================

FOUNDER --> FE
FOUNDER --> HDR

%% Frontend to Command Center
FE_CHAT --> HDR
FE_DASH --> HDR

%% Frontend to backend hot path
FE_CHAT -->|POST /chat/messages/stream SSE| CHAT_ORCH
FE_GOV -->|GET POST /governance/approvals| APPROV
FE_AUDIT -->|GET /governance/audit| AUDITLOG
FE_TASKS -->|/execution/tasks| EXEC_SVC
FE_WORK -->|/workstreams| WORKSTREAM
FE_SCAN -->|/security/scans/start| SCAN_WF
FE_ENG -->|/engagements| SCAN_WF
FE_SECDASH -->|/security/*| SCAN_WF
FE_COMPANY -->|/company-mode/activate| EXEC_SVC
FE_CONN -->|GET POST /connections/v2/*| CONNV2
FE_SETTINGS -->|PUT /settings/user| NBMF
FE_MINDS -->|/souls| SOULS
FE_DEPTS -->|/departments| DEPT_TBL
FE_SKILLS -->|/skills| SKILL_CRUD
FE_POL -->|/policies| POLICY
FE_ANA -->|/analytics| AUDITLOG
FE_FILES -->|/files| BG_QUEUE
FE_PROJ -->|/projects| EXEC_SVC
FE_PIPE -->|/projects?stage=| EXEC_SVC

HDR_BELL -->|hydrate /notifications| NOTIF_ROW
HDR_HEART -->|GET /heartbeat/status| HEART
HDR_GOV -->|persistUiPref| NBMF

%% Chat 10-stage pipeline
CHAT_ORCH -->|Stage 0a| BEHAV
CHAT_ORCH -->|Stage 0b| GATE
CHAT_ORCH -->|Stage 2| TIER_ROUTER
CHAT_ORCH -->|Stage 3| GOVENG
CHAT_ORCH -->|Stage 4 cost preflight| AUDITLOG
CHAT_ORCH -->|Stage 5 select| RUNREG
CHAT_ORCH -->|Stage 6 recall| NBMF
CHAT_ORCH -->|Stage 6 skills| REFINERY
CHAT_ORCH -->|Stage 7 system prompt| SOULS
CHAT_ORCH -->|Stage 8 stream| SSE_BUS
CHAT_ORCH -->|Stage 9 persist| NBMF
CHAT_ORCH -->|Stage 10 audit| AUDITLOG

%% EXE mode: orchestrator -> daenabot/tools
CHAT_ORCH -->|EXE Stage 7.5 dispatch| EXEC_SVC
EXEC_SVC -->|tool call| MCP_V2
EXEC_SVC -->|tool call| SKILL_CRUD
EXEC_SVC -->|background| BG_QUEUE
EXEC_SVC -->|completion| NOTIF

%% Cognition wiring
TIER_ROUTER -->|simple| RUNREG
TIER_ROUTER -.->|complex / risky| COUNCIL
TIER_ROUTER -.->|QE selected| QE
COUNCIL --> QE
QE -->|inject lenses| DCP
COUNCIL -->|synthesizer| RUNREG
OODA -->|EXE only - feature flagged| CHAT_ORCH
OODA --> META
META --> FRAMEWORKS
OODA -.->|reflect| LEARN
OODA -->|recall + store| NBMF

%% Governance edges
GATE --> HARDLAW
BEHAV --> HARDLAW
ASSET --> HARDLAW
POLICY --> GOVENG
GOVENG -->|tier 3+| APPROV
APPROV -->|reject| NOTIF
APPROV -->|emit| AUDITLOG
HARDLAW -->|always| AUDITLOG

%% Department routing
CHAT_ORCH -->|VP Stage 2.8 if flag on| DEPT_ROUTER
DEPT_ROUTER --> DEPT_TBL
DEPT_ROUTER --> SOULS
DEPT_TBL --> EXEC_SVC

%% Capability registry
RUNREG --> CONNV2
CONNV2 --> OPLOCK
SKILL_CRUD --> TLM
TLM --> TOOLCAT
TLM -->|inject schemas| CHAT_ORCH

%% Runtime adapters
RUNREG --> CLAUDE_CLI
RUNREG --> CODEX_CLI
RUNREG --> GEMINI_CLI
RUNREG --> GROK_CLI
RUNREG --> OLLAMA
RUNREG --> VLLM
RUNREG --> MCP_V2

%% MCP V1 legacy still active
FE_CONN -.->|legacy V1 panel| MCP_V1
MCP_V1 -.-> CONNV2

%% Refinery
REFINERY --> REFINEDSKILL
REFINERY -.->|vault export STUB| VAULT

%% Security pipeline
SCAN_WF --> SCOPE
SCAN_WF --> LAEVATEINN
LAEVATEINN --> CKG
SCAN_WF -.->|founder + LOCAL + KEY| EVILBOB
SCAN_WF --> ENGAGE
SCAN_WF --> REPORT
SCAN_WF -->|emit| AUDITLOG

%% Heartbeat
HEART --> CRON
HEART -->|emit| NOTIF
HEART -.->|finding| EXEC_SVC

%% Memory + Dream + Learning
NBMF -.->|background| DREAM
DREAM -.->|MERGE PROMOTE| NBMF
DREAM -.->|emit| AUDITLOG
LEARN -.->|in-memory only - NOT PERSISTED| NBMF
LEARN -.->|future| REFINEDSKILL
EXP -.->|DEFINED but no writer| NBMF

%% Notifications
NOTIF --> NOTIF_ROW
NOTIF_ROW -->|GET poll| HDR_BELL

%% Audit
AUDITLOG -->|FE read| FE_AUDIT

%% Deployment
LOCAL -->|active| CHAT_ORCH
CLOUD -.->|paused| CHAT_ORCH

