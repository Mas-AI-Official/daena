# ============================================================
# Daena Configuration
# ============================================================
# Copy this file to backend/.env and fill in your values.
# See README.md for setup instructions.
# ============================================================

# --- Application ---
APP_NAME=Daena
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database ---
# SQLite for local dev (no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./daena_dev.db
# PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://daena:yourpassword@localhost:5432/daena

# --- Authentication (JWT) ---
# IMPORTANT: Change these in production!
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Redis (optional, app degrades gracefully without it) ---
REDIS_URL=redis://localhost:6379/0

# --- LLM Providers (fill in to enable) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1:latest
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# PERPLEXITY_API_KEY=pplx-...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-...
# TOGETHER_API_KEY=...

# --- Feature Flags ---
ENABLE_WEB3=false
ENABLE_DAENABOT=true
DISABLE_AUTH=false

# --- Vault Encryption ---
# IMPORTANT: Change in production! Must be 32 bytes for AES-256.
VAULT_ENCRYPTION_KEY=change-me-to-a-random-32-byte-key

# --- Daena-Mind Vault (optional, for NBMF memory export) ---
# DAENA_MIND_PATH=/path/to/Daena-Mind

# --- Voice (optional) ---
# ELEVENLABS_API_KEY=sk_...

# --- Celery (optional, for background tasks) ---
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
