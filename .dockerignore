# ==============================================================
# Daena Docker Build Ignore
# ==============================================================

# Version control
.git
.gitignore
.claude

# MCP/packages (not needed in container)
packages
mempalace.yaml
entities.json

# Node dependencies (rebuilt in container)
frontend/node_modules
node_modules

# Python caches and venvs
__pycache__
*.pyc
*.pyo
.venv
venv_daena
venv_daena_main_py310
backend/__pycache__
backend/**/__pycache__

# Documentation (not needed in production image)
Doc
Doc.zip

# Archive
.archive
backend/.archive

# Test artifacts
frontend/test-results
frontend/e2e
backend/tests
*.test.*
.coverage
htmlcov

# Development databases
*.db
daena_dev2.db
backend/daena_dev2.db

# IDE and editor files
.vscode
.idea
*.swp
*.swo

# Environment files (secrets, never bake in)
.env
.env.local
.env.production
.env.production.example
backend/.env

# Build artifacts that will be rebuilt
frontend/dist

# Misc
*.log
*.pid
.DS_Store
Thumbs.db
ShaderCache
CrashpadMetrics*
BrowserMetrics
DeferredBrowserMetrics
component_crx_cache
segmentation_platform
Default
Variations
"Last Version"
"Local State"

# Agent harness (dev tooling)
agent-harness

# Scripts (not needed in container)
scripts
*.bat
setup-daena.bat
start-daena.bat
start-backend.bat
start-frontend.bat
start-ollama.bat
stop-daena.bat
health-check.bat
