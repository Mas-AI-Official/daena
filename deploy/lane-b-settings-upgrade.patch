@@ -391,6 +391,71 @@ class SoulEngine:
 
         return company_section + base + dept_section + addendum
 
+    @classmethod
+    def build_agent_system_prompt(
+        cls,
+        governance_mode: str = "GOVERNED",
+        *,
+        department: str | None = None,
+        sub_capability: str | None = None,
+        company_context: Any = None,
+    ) -> str:
+        """Compose the FULL system prompt for any agent: soul + role.
+
+        This is the single composition point every execution path should use
+        so the soul (core character, Fable-class reasoning, anti-sycophancy,
+        grounding) and the department Mind overlay travel with EVERY agent --
+        the chat path, department agents, and the multi-capability swarm
+        alike. Before this helper existed, the swarm and department paths
+        injected only the per-role prompt via ``get_agent_prompt`` and shipped
+        de-souled agents (no soul, no reasoning rigor, no anti-sycophancy).
+
+        Layer order (highest LLM attention first):
+            1. Core soul + department Mind overlay + governance addendum
+               (delegated to ``get_soul_prompt``)
+            2. Sub-capability role prompt (from ``department_prompts``),
+               tagged ``[department.sub_capability]``
+
+        Degrades safely: a missing soul or an unresolved role each drop out
+        without raising, matching the Daena rule "never break a working path."
+
+        Args:
+            governance_mode: UNLEASHED, BALANCED, or GOVERNED.
+            department: Department name, slug, or Mind name (see
+                ``_DEPARTMENT_SLUG_ALIASES``).
+            sub_capability: MIND / EYES / HANDS / VOICE / SHIELD / MEMORY.
+            company_context: Optional CompanyContext, forwarded to
+                ``get_soul_prompt`` for the founder-scoped company brief.
+
+        Returns:
+            System prompt string ready to lead an agent invocation.
+        """
+        soul = cls.get_soul_prompt(
+            governance_mode,
+            department=department,
+            company_context=company_context,
+        )
+        parts: list[str] = []
+        if soul:
+            parts.append(soul)
+
+        if department and sub_capability:
+            try:
+                from app.services.department_prompts import get_agent_prompt
+                role = get_agent_prompt(department, sub_capability)
+                if role:
+                    parts.append(
+                        "\n\n---\n\n"
+                        f"## YOUR ROLE -- [{department}.{sub_capability}]\n"
+                        + role
+                    )
+            except Exception:
+                logger.warning(
+                    "soul_engine.agent_role_prompt_failed", exc_info=True
+                )
+
+        return "".join(parts)
+
